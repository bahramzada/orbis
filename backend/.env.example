APP_ENV=development
ORBIS_API_TOKEN=
METRICS_API_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Orbis
OPENROUTER_MAX_CONNECTIONS=20
OPENROUTER_MAX_KEEPALIVE=10
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=0.4
WORKFLOW_MAX_CONCURRENCY=2
WORKFLOW_STEP_TIMEOUT_SECONDS=90
WORKFLOW_CACHE_TTL_SECONDS=0
FRONTEND_ORIGIN=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSL=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_AUTO_CREATE_TABLES=false
MAX_RECENT_RUNS=100
MAX_EVALUATIONS_PER_RUN=20
ENABLE_METRICS=true
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
