APP_ENV=production
ORBIS_API_TOKEN=change-this-shared-token
METRICS_API_TOKEN=change-this-metrics-token

OPENROUTER_API_KEY=change-this-openrouter-key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-frontend-domain.example
OPENROUTER_APP_NAME=Orbis

FRONTEND_ORIGIN=
FRONTEND_ORIGINS=https://your-frontend-domain.example
CORS_ALLOW_CREDENTIALS=false

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_SSL=require
DATABASE_AUTO_CREATE_TABLES=false
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

WORKFLOW_MAX_CONCURRENCY=2
WORKFLOW_STEP_TIMEOUT_SECONDS=90
WORKFLOW_CACHE_TTL_SECONDS=0
OPENROUTER_MAX_CONNECTIONS=20
OPENROUTER_MAX_KEEPALIVE=10
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=0.4
MAX_RECENT_RUNS=100
MAX_EVALUATIONS_PER_RUN=20
ENABLE_METRICS=true
LOG_LEVEL=INFO
PORT=8000
